{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "changelog-sections": [
        {
          "hidden": false,
          "section": "🎉 New features",
          "type": "feat"
        },
        {
          "hidden": false,
          "section": "🐛 Bug fixes",
          "type": "fix"
        },
        {
          "hidden": false,
          "section": "⚡ Performance improvements",
          "type": "perf"
        },
        {
          "hidden": false,
          "section": "‼️ Reverts",
          "type": "revert"
        },
        {
          "hidden": false,
          "section": "📚 Documentation",
          "type": "docs"
        },
        {
          "hidden": false,
          "section": "🎨 Code style",
          "type": "style"
        },
        {
          "hidden": false,
          "section": "🔨 Refactoring",
          "type": "refactor"
        },
        {
          "hidden": false,
          "section": "🧪 Tests",
          "type": "test"
        },
        {
          "hidden": false,
          "section": "📦 Build system",
          "type": "build"
        },
        {
          "hidden": false,
          "section": "⚙️ Continuous integration",
          "type": "ci"
        },
        {
          "hidden": false,
          "section": "🧹 Miscellaneous",
          "type": "chore"
        }
      ],
      "draft": false,
      "extra-files": [
        {
          "path": "README.md",
          "type": "generic"
        }
      ],
      "extra-label": "automata 🤖,autorelease: pending,chore 🧹",
      "include-v-in-tag": true,
      "initial-version": "0.1.0",
      "prerelease": false,
      "pull-request-header": "🤖 I have created a release",
      "pull-request-title-pattern": "chore: Release v${version}",
      "release-type": "terraform-module"
    }
  }
}
